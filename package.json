{
  "name": "rune",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fitness": "for s in .harness/fitness.d/*.sh; do \"$s\" || exit 1; done",
    "verify": "pnpm lint && pnpm typecheck && pnpm fitness",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:up": "scripts/dev-db.sh up",
    "db:down": "scripts/dev-db.sh down",
    "db:reset": "scripts/dev-db.sh reset",
    "db:status": "scripts/dev-db.sh status"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "nuxt": "latest",
    "postgres": "^3.4.7",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "latest",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.2.4",
    "drizzle-kit": "^0.31.6",
    "eslint": "latest",
    "eslint-plugin-format": "latest",
    "tailwindcss": "^4.2.4"
  }
}
